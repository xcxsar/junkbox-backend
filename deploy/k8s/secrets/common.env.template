# Copiar a deploy/k8s/secrets/common.env (ignorado por git) y completar.
# `make k8s-secrets` crea con él el Secret junkbox-common.
# Sin comillas: kubectl --from-env-file toma el valor literal.

# El host es el contenedor de compose en la red Docker "kind".
DATABASE_URL=postgres://postgres:junkbox_secure_dev_password@postgres-junkbox:5432/junkbox_db?sslmode=disable

# El mismo en las 4 réplicas: un token firmado por una debe validar en las demás.
# Generar con: openssl rand -hex 32
JWT_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

SMTP_USERNAME=
SMTP_PASSWORD=
